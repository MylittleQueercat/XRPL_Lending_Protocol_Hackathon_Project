# Compose interpolation only. Dokploy uses its environment editor for these.
# Use the inspected instance values, not unverified example entrypoint names.
# RAISE_DOMAIN is a hostname only: no scheme, port, slash or trailing dot.
RAISE_DOMAIN=
RAISE_ROUTER_NAME=
TRAEFIK_HTTP_ENTRYPOINT=
TRAEFIK_HTTPS_ENTRYPOINT=
TRAEFIK_CERT_RESOLVER=
# Pin each release to its source commit; retain the previous image for rollback.
RAISE_IMAGE_TAG=
# Keep this name unchanged for redeployments and rollback of the same instance.
RAISE_VOLUME_NAME=

# Compose explicitly injects the following runtime values into the web service:
# RAISE_MARKET_ORIGIN=https://<RAISE_DOMAIN> (no trailing slash)
# RAISE_MARKET_DB_PATH=/data/market.sqlite (the named persistent volume)
# NEXT_TELEMETRY_DISABLED=1 and NODE_ENV=production
# No NEXT_PUBLIC_* build arguments or wallet seeds are required.
