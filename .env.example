# Compose interpolation. Set these in the Dokploy Environment editor.
# Domains tab: same hostname, service web, container port 3000, HTTPS + letsencrypt.
# Do not add duplicate Traefik labels in Compose.
RAISE_DOMAIN=
# Immutable release identifier; retain the previous image for rollback.
RAISE_IMAGE_TAG=
# Stable unique volume name; never change it for an ordinary redeployment.
RAISE_VOLUME_NAME=

# Compose explicitly injects the following runtime values:
# RAISE_MARKET_ORIGIN=https://<RAISE_DOMAIN> (no trailing slash)
# RAISE_MARKET_DB_PATH=/data/market.sqlite
# NEXT_TELEMETRY_DISABLED=1 and NODE_ENV=production
# No NEXT_PUBLIC_* build arguments or wallet seeds are required.
